ARG NAME=homebox
ARG BASE=registry.fedoraproject.org/fedora-toolbox:${fedora_version}

FROM ${BASE}

LABEL name="$NAME" \
      summary="Fedora toolbox tech container for admin and development stuff" \
      maintainer="morph"

ENV EDITOR=nvim


# Install packages
RUN dnf -y upgrade \
  && dnf -y install \
    aircrack-ng \
    ampy \
    bat \
    esptool \
    fastfetch \
    flashrom \
    hdparm \
    htop \
    imapsync \
    inotify-tools \
    inxi \
    iptstate \
    jq \
    lynx \
    macchanger \
    mc \
    mtr \
    ncdu \
    nethogs \
    nmap \
    nvme-cli \
    pwgen \
    ripgrep \
    screen \
    smartmontools \
    tcpdump \
    tio \
    tmux \
    tree \
    unzip \
    whois \
    wireshark-cli \
  && dnf clean all

