ARG NAME=homebox
ARG BASE=registry.fedoraproject.org/fedora-toolbox:${fedora_version}

FROM ${BASE}

LABEL name="$NAME" \
      summary="Fedora VS code and Claude container" \
      maintainer="morph"

ENV EDITOR=nvim

COPY claude.repo /etc/yum.repos.d/claude.repo
COPY vscode.repo /etc/yum.repos.d/vscode.repo
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc

# Install packages
RUN dnf -y upgrade \
  && dnf -y install \
    claude-code \
    code \
    labwc \
    waypipe \
    && dnf clean all

RUN bootc container lint