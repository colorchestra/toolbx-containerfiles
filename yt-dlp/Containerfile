ARG NAME=yt-dlp
ARG BASE=registry.fedoraproject.org/fedora-toolbox:${fedora_version}

FROM ${BASE}

LABEL name="$NAME" \
      summary="Youtube downloader toolbox container" \
      maintainer="morph"

ENV EDITOR=nvim

# Install Deno
RUN curl -fSL -o /tmp/install.sh https://deno.land/install.sh \
  && chmod +x /tmp/install.sh
RUN /tmp/install.sh --yes

# Install packages
RUN dnf -y upgrade \
  && dnf -y install https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
  && dnf -y install https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm \
  && dnf -y install \
  ffmpeg ffmpeg-libs python python3-pip x264 x264-libs \
  && dnf clean all

RUN pip install \
  yt-dlp \
  yt-dlp-ejs

COPY bin/* /usr/bin/
